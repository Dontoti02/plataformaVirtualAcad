APP_NAME=
APP_ENV=
APP_KEY=
# Firma de las sesiones: propia de esta institución, nunca compartida.
JWT_SECRET=
APP_DEBUG=
APP_TIMEZONE=
APP_URL=
APP_FRONTEND_URL=
APP_RELEASE=

APP_LOCALE=
APP_FALLBACK_LOCALE=
APP_FAKER_LOCALE=

LOG_CHANNEL=
LOG_STACK=
LOG_LEVEL=

# --- Modo de despliegue: una institución por VPS (§1.2, §3.1) ---
DEPLOY_MODE=
TENANT_ID=
INSTITUTION_ID=
CENTRAL_DOMAINS=

# --- MySQL local del VPS ---
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_TENANT_DATABASE=

# --- Redis local: cola, caché y sesión (§3.5) ---
REDIS_CLIENT=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
QUEUE_CONNECTION=
# Mayor que el --timeout del worker (1800 s). En esta línea el valor por defecto
# es 90 s: una importación larga se habría relanzado mientras seguía corriendo.
REDIS_QUEUE_RETRY_AFTER=
CACHE_STORE=
SESSION_DRIVER=
SESSION_LIFETIME=

# --- Archivos en el disco del VPS, no en object storage (§3.6) ---
# `local` (raíz storage/app), el disco para el que está escrito el código: guarda
# con ->store('public/…') y la web los pide en /storage/…. Con `public` la ruta
# quedaba duplicada (storage/app/public/public/…) y las imágenes no se veían.
FILESYSTEM_DISK=

# --- CORS: el origen exacto del frontend, sin comodines (§1.3) ---
CORS_ALLOWED_ORIGINS=

# --- Panel de despliegue ---
PANEL_URL=
PANEL_TOKEN=

# --- Correo ---
#
# De momento DESACTIVADO: MAIL_MAILER=
# enviarlos. La aplicación sigue funcionando y la cola no acumula fallos.
# Para activarlo, pon MAIL_MAILER=
# (contraseña de aplicación, no la del correo, con 2FA activo en la cuenta).
MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# --- Dimensionado de php-fpm ---
#
# ~90 MB por proceso. Se calcula desde la RAM del VPS dejando margen para MySQL,
# Redis y el sistema. Lo rellena el panel con lo que detecta el preflight.
PHP_FPM_MAX_CHILDREN=
PHP_FPM_START_SERVERS=
PHP_FPM_MIN_SPARE=
PHP_FPM_MAX_SPARE=

HASH_VERIFY=
